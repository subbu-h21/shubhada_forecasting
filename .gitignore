# --- Secrets ---
# Mobile server login (username/password) - auto-generated on first run, never commit
server_config.json

# ask.py's OpenRouter/Vertex API key and other local-only env vars
.env

# --- Real business data ---
# Sales/purchase registers contain patient names, supplier terms, and
# financials. This is private business + customer data and must never be
# pushed to a repo, public or private.
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep

# On-demand employee-performance exports from shubhadahealth.com, dropped in
# manually when a question needs them - real employee names + KPI/earnings
# data. Never permanent, never committed.
data/employee_targets/*
!data/employee_targets/.gitkeep

# Same for on-demand attendance/leave snapshots (that site has no export for
# this report, so it's saved manually from a live logged-in session instead)
# - real employee names + daily punch times.
data/employee_attendance/*
!data/employee_attendance/.gitkeep

# Generated reports also contain real figures (revenue, profit, margins)
reports/**/*.xlsx

# Local rotating backups of data/processed - same real business data, just
# copied. Not a substitute for an off-site backup (see README).
backups/

# --- Logs ---
server.log
*.log

# --- Python ---
__pycache__/
*.pyc
.venv/
venv/

# --- OS/editor cruft ---
.DS_Store
Thumbs.db

# --- Machine-specific shortcuts ---
# Desktop shortcuts point to an absolute local path - meaningless on another PC
*.lnk
